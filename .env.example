# Parser Service - RAGFlow Core Environment Configuration

# ============= MySQL 配置 =============
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=rag_flow
MYSQL_PASSWORD=infini_rag_flow
MYSQL_DB=rag_flow

# ============= Redis 配置 =============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=infini_rag_flow

# ============= Elasticsearch 配置 =============
ES_HOST=http://localhost
ES_PORT=9200
ES_USERNAME=
ES_PASSWORD=

# ============= MinIO 配置 =============
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=rag_flow
MINIO_SECRET_KEY=infini_rag_flow
MINIO_BUCKET=ragflow

# ============= 服务配置 =============
RAGFLOW_HOST=0.0.0.0
RAGFLOW_PORT=9380

# ============= Embedding 模型配置（OpenAI 协议兼容） =============
# 本地 vLLM 示例
EMBEDDING_BASE_URL=http://localhost:6380
EMBEDDING_API_KEY=your-api-key
EMBEDDING_MODEL=bge-m3

# 或使用 OpenAI
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_MODEL=text-embedding-3-small

# ============= LLM 配置（可选） =============
LLM_BASE_URL=http://localhost:6380
LLM_API_KEY=your-api-key
LLM_MODEL=qwen2.5-7b-instruct

# ============= 日志配置 =============
LOG_LEVEL=INFO
